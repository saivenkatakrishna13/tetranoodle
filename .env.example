# Copy this file to .env and set your key. Never commit .env.
GROQ_API_KEY_MIRA=
GROQ_API_KEY_ARJUN=
GROQ_API_KEY_NOVA=
GROQ_API_KEY_SAGE=
GROQ_API_KEY_LEO=
# Optional shared fallback (leave blank when using individual keys)
GROQ_API_KEY=
# Shared key pool for ALL five agents: comma-separated Groq keys; when set it wins over the per-role keys above.
GROQ_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001
# In production, permit your Vercel frontend to call this API. Use your actual
# URL, with no trailing slash. Multiple origins can be comma-separated.
APP_ORIGIN=https://your-project.vercel.app
# Set this only in Vercel's frontend environment settings. It is the deployed
# backend origin, not an /api path: https://your-scholarx-api.onrender.com
VITE_API_BASE_URL=
# Python 3.10+ environment containing Scrapling and ddgs
PYTHON_PATH=.venv/bin/python
# Optional Tavily search. Without it, Groq browser search is preferred, then ddgs.
TAVILY_API_KEY=

# Role-specific models; search uses the built-in browser tool on GPT-OSS.
GROQ_MODEL_MIRA=openai/gpt-oss-120b
GROQ_MODEL_ARJUN=openai/gpt-oss-120b
GROQ_MODEL_NOVA=openai/gpt-oss-20b
GROQ_MODEL_SAGE=openai/gpt-oss-20b
GROQ_MODEL_LEO=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Stronger model for the practical funding/admissions evidence pass
GROQ_DETAIL_MODEL=openai/gpt-oss-120b

# Continue on another available Groq model when a primary daily allowance is exhausted
GROQ_DAILY_FALLBACK_MODEL=qwen/qwen3.8-27b
# Optional server-side token for higher GitHub public API limits; public-page fallback works without it
GITHUB_TOKEN=

# Independent search avoids spending Groq generation quota on discovery.
SEARCH_PROVIDER=ddgs
# Total active run time, including draft preparation. Only manual Resume continues a paused run.
RESEARCH_BUDGET_MS=480000
DRAFT_BUDGET_MS=45000
# Maximum high-level web/document tools and model completions across the run.
RESEARCH_MAX_TOOL_CALLS=100

# Optional search fallbacks: Tavily -> Serper -> Brave -> ddgs -> Groq -> cache
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional per-million input/output USD prices with their official source URL.
# Unknown prices remain Missing. Example shape (replace with verified prices):
# MODEL_PRICING_JSON={"model-id":{"input":0.0,"output":0.0,"source":"https://provider.example/pricing"}}
MODEL_PRICING_JSON=
# Optional Unicode TrueType font for PDF reports on another operating system.
SCHOLARX_PDF_FONT=

# Compact official-page extraction; full source text remains cached for evidence checks.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
# Source ownership and the independent critic use Sage's same API key, with
# separate model allowances so extraction does not consume their whole budget.
GROQ_SOURCE_MODEL=openai/gpt-oss-120b
GROQ_CRITIC_MODEL=openai/gpt-oss-120b
# Reserve calls for Mira/Leo after discovery and verification (max 15% of run budget).
RESEARCH_RESERVE_CALLS=14
