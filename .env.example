# Copy this file to .env and set your key. Never commit .env.
GROQ_API_KEY_MIRA=
GROQ_API_KEY_ARJUN=
GROQ_API_KEY_NOVA=
GROQ_API_KEY_SAGE=
GROQ_API_KEY_LEO=
# Optional shared fallback (leave blank when using individual keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001
# Python 3.10+ environment containing Scrapling and ddgs
PYTHON_PATH=.venv/bin/python
# Optional Tavily search. Without it, Groq browser search is preferred, then ddgs.
TAVILY_API_KEY=

# Role-specific models; search uses the built-in browser tool on GPT-OSS.
GROQ_MODEL_MIRA=openai/gpt-oss-120b
GROQ_MODEL_ARJUN=openai/gpt-oss-120b
GROQ_MODEL_NOVA=openai/gpt-oss-20b
GROQ_MODEL_SAGE=openai/gpt-oss-20b
GROQ_MODEL_LEO=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Stronger model for the practical funding/admissions evidence pass
GROQ_DETAIL_MODEL=openai/gpt-oss-120b

# Continue on another available Groq model when a primary daily allowance is exhausted
GROQ_DAILY_FALLBACK_MODEL=qwen/qwen3.8-27b
# Optional server-side token for higher GitHub public API limits; public-page fallback works without it
GITHUB_TOKEN=
